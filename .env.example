# Copy to .env (git-ignored) and adjust. Placeholders only; never commit real secrets.
# Read by docker compose and by the backend (spring.config.import of ../.env).

# --- Database ---
POSTGRES_DB=finflow
POSTGRES_HOST_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/finflow
DB_USERNAME=finflow
DB_PASSWORD=change-me-local-only

# --- Kafka (compose broker on the host's port 9092) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Managed Kafka example: KAFKA_SECURITY_PROTOCOL=SASL_SSL, KAFKA_SASL_MECHANISM=SCRAM-SHA-256,
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="..." password="...";
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# --- Redis (compose Redis on host port 6380) ---
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380

# --- Backend ---
SERVER_PORT=8080
FINFLOW_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Enables /api/ops/** (dead-letter replay, ledger reversal). Leave empty to disable. Use a long random value.
FINFLOW_OPS_TOKEN=

# Demo mode: exposes POST /api/v1/demo/session for the shared, fake demo merchant.
FINFLOW_DEMO_ENABLED=true
FINFLOW_DEMO_SEED=true
# Fixed demo key; required when running more than one backend instance. Empty = random per start.
FINFLOW_DEMO_API_KEY=

# --- Provider simulator ---
FINFLOW_SIMULATOR_LATENCY_MS=120
FINFLOW_SIMULATOR_TIMEOUT_MS=1500
FINFLOW_SIMULATOR_OUTAGE=false

# --- Reliability tuning ---
FINFLOW_REFUND_WINDOW_DAYS=180
FINFLOW_WEBHOOK_RETRY_SCHEDULE=2s,10s,30s,2m,10m
FINFLOW_AUTO_SYNC_DELAY=5s
FINFLOW_RECONCILIATION_INTERVAL=10m
FINFLOW_RATE_LIMIT_RPM=300
FINFLOW_RATE_LIMIT_WRITES_PM=60

# --- Observability ---
# JSON logs: ecs or logstash. Empty = human-readable.
FINFLOW_LOG_FORMAT=
FINFLOW_TRACING_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
GRAFANA_ADMIN_PASSWORD=change-me-local-only
