{
  "title": "FinFlow overview",
  "uid": "finflow-overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "finflow"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Outbox pending events",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(finflow_outbox_pending)"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Outbox lag",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(finflow_outbox_lag_seconds)"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Webhook deliveries due",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(finflow_webhook_deliveries_due)"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Open reconciliation findings (1h)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(finflow_reconciliation_findings_total{resolution!=\"AUTO_RESOLVED\"}[1h]))"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Payment outcomes per minute",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(finflow_payment_events_total[5m])) * 60",
          "legendFormat": "{{type}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Payment processing latency (create \u2192 final state)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(finflow_payment_processing_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(finflow_payment_processing_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(finflow_payment_processing_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Provider latency p95 by operation",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(finflow_provider_latency_seconds_bucket[5m])))",
          "legendFormat": "{{operation}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "HTTP requests per second by status",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Webhook attempts and retries per minute",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(finflow_webhook_attempts_total[5m])) * 60",
          "legendFormat": "attempt {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(finflow_webhook_retries_scheduled_total[5m])) * 60",
          "legendFormat": "retries scheduled"
        },
        {
          "refId": "C",
          "expr": "sum(rate(finflow_webhook_deliveries_failed_total[5m])) * 60",
          "legendFormat": "permanently failed"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag (max records) by group",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (client_id) (kafka_consumer_fetch_manager_records_lag_max)",
          "legendFormat": "{{client_id}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer retries and dead letters",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(finflow_kafka_consumer_retries_total[5m])) * 60",
          "legendFormat": "retries/min"
        },
        {
          "refId": "B",
          "expr": "sum(rate(finflow_kafka_consumer_dead_lettered_total[5m])) * 60",
          "legendFormat": "dead-lettered/min"
        },
        {
          "refId": "C",
          "expr": "sum(rate(finflow_kafka_consumer_duplicates_total[5m])) * 60",
          "legendFormat": "duplicates ignored/min"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Idempotency outcomes and Redis failures",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(finflow_idempotency_requests_total[5m])) * 60",
          "legendFormat": "idempotency {{result}}"
        },
        {
          "refId": "B",
          "expr": "sum by (use) (rate(finflow_redis_failures_total[5m])) * 60",
          "legendFormat": "redis failure ({{use}})"
        },
        {
          "refId": "C",
          "expr": "sum(rate(finflow_ratelimit_rejected_total[5m])) * 60",
          "legendFormat": "rate-limited"
        }
      ],
      "id": 12
    }
  ]
}